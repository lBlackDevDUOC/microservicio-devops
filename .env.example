# Copiar a .env y reemplazar los valores (el archivo .env no se versiona)
MYSQL_ROOT_PASSWORD=cambiar-root
MYSQL_DATABASE=tienda_perritos
MYSQL_USER=alumno
MYSQL_PASSWORD=cambiar-password

# Imagenes: local para desarrollo, ghcr.io/<owner> en el pipeline
IMAGE_REGISTRY=local
IMAGE_TAG=dev

BACKEND_REPLICAS=2
FRONTEND_PORT=8080

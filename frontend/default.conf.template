server {
    listen 8080;
    server_name _;

    charset utf-8;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Cabeceras de seguridad
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'" always;

    gzip on;
    gzip_types text/css application/javascript application/json;

    # Health check del frontend (Docker HEALTHCHECK y probes de Kubernetes)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # SPA / frontend estatico
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy hacia el backend (Docker Compose o Service de Kubernetes)
    location /api/ {
        proxy_pass ${BACKEND_URL};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
